        "name": "Player Dead",
        "assignable": false,
        "defaultFile": "sound/player_dead.mp3",
        "defaultVolume": 10
      }
    ],
    "assetCategories": [
      {
        "name": "boxarts",
        "title": "Game Boxarts",
        "allowedTypes": [
          "jpg",
          "jpeg",
          "gif",
          "png",
          "webp"
        ]
      },
      {
        "name": "popovers",
        "title": "Player Popovers",
        "allowedTypes": [
          "jpg",
          "jpeg",
          "gif",
          "png",
          "webp"
        ]
      },
      {
        "name": "eventLogos",
